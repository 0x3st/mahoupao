{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mahoupao-index",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
